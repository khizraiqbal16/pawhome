PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pet-adoption
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
# Optional: leave empty to use demo payment mode
STRIPE_SECRET_KEY=
CURRENCY=usd

# Admin account created by: node createAdmin.js
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Cloudinary for photo storage in production (needed on Render)
CLOUDINARY_URL=

# Optional email (Gmail example: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PawHome <youraddress@gmail.com>"
